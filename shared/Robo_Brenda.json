    {
      "parameters": {
        "jsCode": "// Lead Qualification Logic for Apex Roofing\nconst args = $json.args || {};\nconst service = (args.service_requested || \"\").toLowerCase();\nconst email = (args.caller_email || \"\").toLowerCase();\n\nlet score = 0;\nlet status = \"new_lead\";\n\n// 1. Service Urgency Score (High for active issues)\nif (service.includes(\"leak\") || service.includes(\"emergency\") || service.includes(\"storm\")) {\n  score += 50;\n} else if (service.includes(\"replacement\") || service.includes(\"new roof\")) {\n  score += 30;\n}\n\n// 2. Business/Professional Email Score\nconst professionalDomains = [\"gmail.com\", \"outlook.com\", \"yahoo.com\", \"icloud.com\"];\nconst domain = email.split(\"@\")[1];\nif (domain && !professionalDomains.includes(domain)) {\n  score += 20; // Potential commercial lead\n}\n\n// 3. Status assignment\nif (score >= 50) {\n  status = \"contacted\"; // Prioritize high-value/urgent leads\n}\n\nreturn {\n  args: {\n    ...args,\n    lead_score: score,\n    lead_status: status\n  }\n};"
      },
